# Public client settings only. Never put Appwrite API keys or wallet secrets here.
EXPO_PUBLIC_DEMO_MODE=true
EXPO_PUBLIC_APPWRITE_ENDPOINT=replace_with_https_endpoint_ending_in_v1
EXPO_PUBLIC_APPWRITE_PROJECT_ID=replace_with_project_id
EXPO_PUBLIC_APPWRITE_DATABASE_ID=replace_with_database_id
EXPO_PUBLIC_APPWRITE_POSTS_COLLECTION_ID=replace_with_posts_collection_id
EXPO_PUBLIC_APPWRITE_LEAGUES_COLLECTION_ID=replace_with_leagues_collection_id
EXPO_PUBLIC_APPWRITE_ACTIVITIES_COLLECTION_ID=replace_with_activities_collection_id
EXPO_PUBLIC_APPWRITE_IMAGES_BUCKET_ID=replace_with_images_bucket_id
# Embedded in Android builds. Restrict to Maps SDK for Android + package/SHA-1.
GOOGLE_MAPS_ANDROID_KEY=replace_with_restricted_android_maps_key
